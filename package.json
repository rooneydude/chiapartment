{
  "name": "chiapartment",
  "private": true,
  "version": "0.1.0",
  "description": "Track Chicago apartment prices over time, visualized in 3D",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["shared", "scraper", "web"],
  "scripts": {
    "refresh": "tsx scraper/src/cli.ts refresh",
    "skyline": "tsx scraper/src/cli.ts skyline",
    "unitmap": "tsx scraper/src/cli.ts unitmap",
    "alerts": "tsx scraper/src/cli.ts alerts",
    "build:data": "tsx scraper/src/cli.ts build-data",
    "ci:flags": "tsx scraper/src/cli.ts ci-flags",
    "ci:built-at": "tsx scraper/src/cli.ts built-at",
    "ci:verify-live": "tsx scraper/src/cli.ts verify-live",
    "dev": "npm run build:data && npm run -w web dev",
    "build": "npm run build:data && npm run -w web build",
    "preview": "npm run -w web preview",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -p shared && tsc -p scraper && tsc -p web && tsc -p web/e2e"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
